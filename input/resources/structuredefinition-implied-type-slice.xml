<?xml version="1.0" encoding="UTF-8"?>
<StructureDefinition xmlns="http://hl7.org/fhir" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://hl7.org/fhir ../../input-cache/schemas/R4/fhir-single.xsd">
  <id value="implied-type-slice"/>
  <extension url="http://hl7.org/fhir/StructureDefinition/structuredefinition-fmm">
    <valueInteger value="1"/>
  </extension>
  <url value="http://hl7.org/fhir/tools/StructureDefinition/implied-type-slice"/>
  <name value="ImpliedTypeSliceExt"/>
  <title value="Implied Type Slice Extension"/>
  <status value="active"/>
  <experimental value="false"/>
  <publisher value="HL7 International / FHIR Infrastructure"/>
  <contact>
    <telecom>
      <system value="url"/>
      <value value="http://hl7.org/Special/committees/fhir-i"/>
    </telecom>
  </contact>
  <description value="Marks a type slice that the snapshot generator added to complete a type slicing. Type slicing is always closed, so when the slices that a profile defines do not cover every type the element still allows, the snapshot generator adds an empty slice for each remaining type. These slices add no constraints of their own; this extension marks them so that renderers can leave them out, and so that when a profile is derived from this one they are regenerated rather than inherited"/>
  <jurisdiction>
    <coding>
      <system value="http://unstats.un.org/unsd/methods/m49/m49.htm"/>
      <code value="001"/>
    </coding>
  </jurisdiction>
  <fhirVersion value="4.0.1"/>
  <kind value="complex-type"/>
  <abstract value="false"/>
  <context>
    <type value="element"/>
    <expression value="ElementDefinition"/>
  </context>
  <type value="Extension"/>
  <baseDefinition value="http://hl7.org/fhir/StructureDefinition/Extension"/>
  <derivation value="constraint"/>
  <differential>
    <element id="Extension">
      <path value="Extension"/>
      <short value="A type slice added by the snapshot generator to complete a closed type slicing"/>
      <definition value="This slice was added by the snapshot generator so that the (always closed) type slicing still allows a type that no slice in the profile covers. It adds no constraints of its own. Only used in snapshots; set by the snapshot generator."/>
      <min value="0"/>
      <max value="1"/>
    </element>
    <element id="Extension.extension">
      <path value="Extension.extension"/>
      <max value="0"/>
    </element>
    <element id="Extension.url">
      <path value="Extension.url"/>
      <fixedUri value="http://hl7.org/fhir/tools/StructureDefinition/implied-type-slice"/>
    </element>
    <element id="Extension.value[x]">
      <path value="Extension.value[x]"/>
      <min value="1"/>
      <max value="1"/>
      <type>
        <code value="boolean"/>
      </type>
    </element>
  </differential>
</StructureDefinition>
